<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>b2c3d4e5-f6a7-8901-bcde-678901234567</Id>
  <Version>1.1.0</Version>
  <ProviderName>Vistamark Investments</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Vistamark AI"/>
  <Description DefaultValue="Revise emails with Claude AI inside Outlook."/>
  <IconUrl DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-64.png"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://mrrvista.github.io/vistamark-addin/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <RequestedWidth>460</RequestedWidth>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://mrrvista.github.io/vistamark-addin/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://mrrvista.github.io/vistamark-addin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="AI Assistant"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Vistamark AI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Revise this email with Claude AI — powered by Vistamark."/>
      </bt:LongStrings>
    </Resources>

    <!--
      v5.16.0: VersionOverridesV1_1 inner block adds OnMessageSend
      LaunchEvent for edit-distance telemetry. Modern Outlook clients
      (Mailbox 1.12+: web, new Outlook for Windows, Mac, mobile) read
      this block; older clients ignore it and still get the V1_0
      taskpane experience above.

      The LaunchEvent fires when the partner clicks Send. The handler
      (onMessageSendHandler in commands.js) reads the final body via
      Office.context.mailbox.item.body.getAsync(Text), reads the
      vistamarkDraftToken stashed in CustomProperties at Replace Body
      time, fire-and-forget POSTs to /api/inbound/edit-telemetry, and
      calls event.completed({allowEvent: true}) to release the send.

      SendMode="soft-block": if the handler doesn't complete within 5s
      the send proceeds anyway. Our handler is fast (~200ms), so this
      timeout is a safety valve, not the expected path.
    -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="soft-block"/>
              </LaunchEvents>
              <SourceLocation resid="Commands.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://mrrvista.github.io/vistamark-addin/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://mrrvista.github.io/vistamark-addin/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://mrrvista.github.io/vistamark-addin/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="AI Assistant"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Vistamark AI"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Revise this email with Claude AI — powered by Vistamark."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
